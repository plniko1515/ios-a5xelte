 #define A5XELTE_MARKER_PA             0x8ffff100
+#elif defined(ARM64_BOARD_CONFIG_A51)
+/* Galaxy A51 SM-A515F: S-Boot leaves DECON scanning out this buffer. */
+#define A51                           1
+#define A5XELTE_FB_PA                 0xca000000
+#define A5XELTE_FB_WIDTH              1080
+#define A5XELTE_FB_HEIGHT             2400
+#define A5XELTE_FB_STRIDE             4320
+#define A5XELTE_FB_BLOCKS             5     /* 2 MiB VA=PA bootstrap blocks */
+#define A5XELTE_FB_TEXT_SCALE         2
+#define A5XELTE_FB_DOT_PITCH          424   /* 1080 pixels across ~5.2 inches */
+#define A5XELTE_MARKER_PA             0x8ffff100
 #else
 #define A5XELTE_FB_PA                 0x67000000
 #define A5XELTE_FB_WIDTH              1080
